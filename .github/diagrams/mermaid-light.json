{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "IBM Plex Sans, Helvetica, Arial, sans-serif",
    "fontSize": "16px",
    "background": "#fffaf7",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#111114",
    "primaryBorderColor": "#7853ff",
    "secondaryColor": "#f3ebe6",
    "secondaryTextColor": "#111114",
    "secondaryBorderColor": "#e9369d",
    "tertiaryColor": "#f8f2ee",
    "tertiaryTextColor": "#111114",
    "tertiaryBorderColor": "#7853ff",
    "clusterBkg": "#f8f2ee",
    "clusterBorder": "#7853ff",
    "lineColor": "#5b3df0",
    "textColor": "#111114",
    "edgeLabelBackground": "#fffaf7",
    "titleColor": "#111114",
    "actorBkg": "#fff1f7",
    "actorBorder": "#7853ff",
    "actorTextColor": "#111114",
    "actorLineColor": "#c9bfd6",
    "signalColor": "#5b3df0",
    "signalTextColor": "#111114",
    "noteBkgColor": "#f3eefe",
    "noteTextColor": "#111114",
    "noteBorderColor": "#7853ff",
    "sequenceNumberColor": "#ffffff",
    "labelBoxBkgColor": "#fff1f7",
    "labelTextColor": "#111114",
    "activationBkgColor": "#f3eefe",
    "activationBorderColor": "#7853ff"
