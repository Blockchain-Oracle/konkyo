    "actorBkg": "#211922",
    "actorBorder": "#c9ff3d",
    "actorTextColor": "#fffaf7",
    "actorLineColor": "#5b4a63",
    "signalColor": "#c9ff3d",
    "signalTextColor": "#fffaf7",
