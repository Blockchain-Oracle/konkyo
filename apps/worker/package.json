    "@konkyo/db": "workspace:*",
    "@konkyo/env": "workspace:*",
    "@konkyo/ingest": "workspace:*",
    "@konkyo/jobs": "workspace:*",
    "@konkyo/notify": "workspace:*",
    "@konkyo/storage": "workspace:*",
    "@konkyo/study": "workspace:*",
    "@konkyo/zetaris": "workspace:*",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@konkyo/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
