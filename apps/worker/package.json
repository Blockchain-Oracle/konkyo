{
  "name": "@konkyo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs tsx watch --clear-screen=false src/index.ts",
    "start": "node ../../scripts/with-env.mjs tsx src/index.ts",
