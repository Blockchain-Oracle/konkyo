# Copy to .env and fill in. Never commit .env.
# Values marked "local" match infra/compose.yaml.

# Postgres (local: infra/compose.yaml)
DATABASE_URL=postgresql://konkyo:konkyo@127.0.0.1:54320/konkyo

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3210
# Browser origin allowed by the S3 store's CORS (local: the web app)
APP_ORIGIN=http://localhost:3210

# Google OAuth client from the "Konkyo Sign-in" Google Cloud project
# (https://console.cloud.google.com/apis/credentials). Redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible storage (local: RustFS in infra/compose.yaml)
S3_ENDPOINT=http://127.0.0.1:9200
S3_PUBLIC_ENDPOINT=http://localhost:9200
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=konkyo-dev
# Generate with: openssl rand -hex 24
S3_SECRET_ACCESS_KEY=

# Document conversion (local: Gotenberg in infra/compose.yaml)
GOTENBERG_URL=http://127.0.0.1:3220

# Zetaris REST API (local: the hackathon bundle; production: the event instance)
ZETARIS_REST_URL=
