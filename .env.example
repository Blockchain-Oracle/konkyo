# Copy to .env and fill in. Never commit .env.
# Values marked "local" match infra/compose.yaml.

# Postgres (local: infra/compose.yaml)
DATABASE_URL=postgresql://konkyo:konkyo@127.0.0.1:54320/konkyo

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3210
# Browser origin allowed by the S3 store's CORS (local: the web app)
APP_ORIGIN=http://localhost:3210

# Google OAuth client from the "Konkyo Sign-in" Google Cloud project
# (https://console.cloud.google.com/apis/credentials). Redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible storage (local: RustFS in infra/compose.yaml)
S3_ENDPOINT=http://127.0.0.1:9200
S3_PUBLIC_ENDPOINT=http://localhost:9200
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=konkyo-dev
# Generate with: openssl rand -hex 24
S3_SECRET_ACCESS_KEY=

# Document conversion (local: Gotenberg in infra/compose.yaml)
GOTENBERG_URL=http://127.0.0.1:3220

# Zetaris REST API (local: the hackathon bundle; production: the event instance)
ZETARIS_REST_URL=

# Models: OpenAI writes and judges; Nemotron on NVIDIA's API plans, embeds and checks safety
OPENAI_API_KEY=
# A free key from build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Optional: a self-hosted NVIDIA NIM serving the same model ids
MODEL_BASE_URL=
# Optional: this process's share of each model's ~40 requests a minute (web and worker split it)
MODEL_REQUESTS_PER_MINUTE=

# Audio and papers
ELEVENLABS_API_KEY=
OPENALEX_API_KEY=

# Zetaris auth: an API key (event instance), or the local bundle's UI login
ZETARIS_API_KEY=
ZETARIS_LOGIN_URL=http://localhost:3000/api/auth/login
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=
# Evidence files: where the worker writes them, and the same folder as Zetaris sees it
EVIDENCE_DIR=./.data/evidence
ZETARIS_EVIDENCE_URI=file:///home/zetaris/customer-data/shared/konkyo

# Web Push: generate with npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://konkyo.xyz

# Connectors (optional): Gmail, Google Drive and Notion through Composio
# (https://platform.composio.dev). One auth config per toolkit; without them Settings says
# connectors aren't set up.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLEDRIVE=
COMPOSIO_AUTH_CONFIG_NOTION=

# Email (optional) through Resend (https://resend.com): without the key, email sign-in codes, invites
# and the weekly digest are off. The webhook secret signs mail sent to a space's own address.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Override the sender and the receiving domain (a test server on another domain).
EMAIL_FROM=
INBOUND_EMAIL_DOMAIN=

# Landing page (optional): the public folder its live demo asks; `pnpm konkyo seed` prints it.
DEMO_SHARE_SLUG=

# Articles (optional): who reads reports of articles, as comma-separated user ids (each lands in their Inbox).
ADMIN_USER_IDS=
